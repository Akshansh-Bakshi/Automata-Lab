{
  "id": "nondeterministic-suffix",
  "name": "Ends with 01",
  "description": "Uses nondeterminism to guess where the final 01 suffix begins.",
  "nfa": {
    "schemaVersion": 1,
    "name": "Binary strings ending in 01",
    "alphabet": ["0", "1"],
    "states": ["q0", "q1", "q2"],
    "initialState": "q0",
    "acceptingStates": ["q2"],
    "transitions": [
      {"from": "q0", "symbol": "0", "to": ["q0", "q1"]},
      {"from": "q0", "symbol": "1", "to": ["q0"]},
      {"from": "q1", "symbol": "1", "to": ["q2"]}
    ]
  }
}

